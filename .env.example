# Mailgun Configuration
# Paste your Mailgun Private API Key below (starts with "key-" or a hex string)
MAILGUN_API_KEY=your_mailgun_private_api_key_here

# Your Mailgun Sending Domain as registered in Mailgun (e.g. baylabtech.com, mg.baylabtech.com, or sandboxXXX.mailgun.org)
MAILGUN_DOMAIN=baylabtech.com

# Target recipient email where incoming quote and contact notifications will be sent
MAILGUN_RECIPIENT_EMAIL=mahomagh@gmail.com

# The "From" email address displayed on incoming alerts
MAILGUN_FROM_EMAIL=BayLabTech <postmaster@baylabtech.com>

# Mailgun API Region: "us" (default api.mailgun.net) or "eu" (api.eu.mailgun.net)
MAILGUN_REGION=us
